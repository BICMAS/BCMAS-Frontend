# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation
/documentation/
# docs/ stays private, except the AI contract the frontend imports via `@ai/contracts`
# (tsconfig paths). Vercel builds from git, so that one file must be committed.
/docs/*
!/docs/ai/
/docs/ai/*
!/docs/ai/contracts/
/docs/ai/contracts/*
!/docs/ai/contracts/ai-contracts.ts

# .env
.env*
.env.local
.env
.env.production.example

# references
/reference-html/

# other documents
AGENTS.md
ARCHITECTURE.md
USER_STORIES.md
USER_STORIES_BACKLOG.md
USER_STORIES_BACKLOG.md