# CFP AI Service — local development configuration.
# Copy to .env (never commit .env). All variables use the CFP_AI_ prefix, except the
# standard provider key names, which are also accepted.

# ── Environment ──────────────────────────────────────────────────────────────
CFP_AI_ENV=dev                     # dev | test | staging | prod
CFP_AI_LOG_LEVEL=INFO
CFP_AI_LOG_JSON=false              # human-readable logs locally

# ── Auth: dev tokens (dev/test only). Staging/prod require auth_mode=jwks. ──
CFP_AI_AUTH_MODE=dev
CFP_AI_DEV_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# Production-style JWKS verification (backend endpoint BE-001 — PROPOSED):
# CFP_AI_AUTH_MODE=jwks
# CFP_AI_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# CFP_AI_JWT_ISSUERS=["https://auth.example.com"]
# CFP_AI_JWT_AUDIENCES=["cfp-api"]

# ── Conventional backend ─────────────────────────────────────────────────────
CFP_AI_BACKEND_MODE=mock           # mock (dev/test only) | http
# CFP_AI_BACKEND_MODE=http
# CFP_AI_BACKEND_BASE_URL=http://localhost:4010/v1   # e.g. a contract-mock server

# ── LLM providers ────────────────────────────────────────────────────────────
# fake = offline scripted responses (dev/test only). Switch to anthropic or openai with a key.
CFP_AI_LLM_DEFAULT_PROVIDER=fake
# CFP_AI_LLM_DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CFP_AI_ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# CFP_AI_LLM_DEFAULT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CFP_AI_OPENAI_DEFAULT_MODEL=        # required for OpenAI — there is deliberately no default

# ── Required outside dev/test ────────────────────────────────────────────────
# CFP_AI_LOG_HASH_KEY=<random secret used to pseudonymise user IDs in logs>

# Development Plan Agent / drafts
# CFP_AI_DEV_PLAN_APPROVAL_MODE=role_approval   # or user_accept
# CFP_AI_DEV_PLAN_MAX_GOALS=6
# CFP_AI_DRAFT_TTL_DAYS=14

# Backend → AI events (BE-080, proposed). /v1/events returns 503 until a secret is set.
# CFP_AI_WEBHOOK_SECRET=
# CFP_AI_WEBHOOK_MAX_SKEW_S=300

# Collaborative workflows: SQLite state file (unset = in-memory) and automatic stage retries
# CFP_AI_WORKFLOW_STORE_PATH=./data/workflows.db
# CFP_AI_WORKFLOW_RETRY_ATTEMPTS=3
# CFP_AI_WORKFLOW_RETRY_BACKOFF_S=0.5

# Backend integration (BACKEND_INTEGRATION_SPEC.md section 4). The base URL must end with /v<major>.
# CFP_AI_BACKEND_API_VERSION=1
# CFP_AI_BACKEND_IDENTITY_MODE=forward            # or exchange (RFC 8693, BE-002)
# CFP_AI_BACKEND_TOKEN_AUDIENCE=                  # exchange mode
# CFP_AI_BACKEND_CLIENT_ID=                       # service identity (BE-003), with the secret below
# CFP_AI_BACKEND_CLIENT_SECRET=
# CFP_AI_BACKEND_CA_BUNDLE=
# CFP_AI_BACKEND_CLIENT_CERT=                     # optional mTLS, with the key below
# CFP_AI_BACKEND_CLIENT_KEY=
# CFP_AI_BACKEND_REFERENCE_CACHE_TTL_S=300
# CFP_AI_BACKEND_MAX_PAGES=10
